{
  "middlewares": [],
  "mcpInterceptors": [
    "my_package.mcp.auth:build_auth_interceptor"
  ],
  "mcpServers": {
    "github": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "$GITHUB_TOKEN"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 60,
      "tool_call_timeout": 60,
      "description": "GitHub MCP server for repository operations"
    },
    "openviking": {
      "enabled": false,
      "type": "http",
      "url": "http://127.0.0.1:1933/mcp",
      "headers": {
        "X-API-Key": "$OPENVIKING_API_KEY"
      },
      "description": "Official OpenViking tools for explicit memory and resource operations"
    },
    "deerflow_capabilities": {
      "enabled": false,
      "type": "stdio",
      "command": "deerflow-capability-mcp",
      "args": [],
      "env": {
        "DOUYIN_CLIENT_KEY": "$DOUYIN_CLIENT_KEY",
        "DOUYIN_CLIENT_SECRET": "$DOUYIN_CLIENT_SECRET",
        "DOUYIN_DEVICE_ID": "$DOUYIN_DEVICE_ID",
        "DOUYIN_APPROVED_SCOPES": "$DOUYIN_APPROVED_SCOPES",
        "DOUYIN_PUBLIC_EVIDENCE_ROOT": "$DOUYIN_PUBLIC_EVIDENCE_ROOT",
        "DOUYIN_PUBLIC_EVIDENCE_UV": "$DOUYIN_PUBLIC_EVIDENCE_UV"
      },
      "tool_name_prefix": false,
      "session_init_timeout": 30,
      "tool_call_timeout": 120,
      "description": "Single Manifest-driven DeerFlow capability gateway; official APIs and reviewed child runtimes remain internal providers",
      "routing": {
        "mode": "off"
      }
    },
    "postgres": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost/mydb"
      ],
      "env": {},
      "description": "PostgreSQL database access",
      "routing": {
        "mode": "prefer",
        "priority": 50,
        "keywords": [
          "database",
          "SQL",
          "table",
          "订单",
          "用户"
        ]
      },
      "tools": {
        "query": {
          "routing": {
            "mode": "prefer",
            "priority": 100,
            "keywords": [
              "查库",
              "订单表",
              "指标"
            ]
          }
        }
      }
    }
  },
  "skills": {
    "marketing-video-production": {
      "enabled": true
    },
    "video-generation": {
      "enabled": false
    }
  }
}
