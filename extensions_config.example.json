{
  "middlewares": [],
  "mcpInterceptors": [
    "my_package.mcp.auth:build_auth_interceptor"
  ],
  "mcpServers": {
    "github": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "$GITHUB_TOKEN"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 60,
      "tool_call_timeout": 60,
      "description": "GitHub MCP server for repository operations"
    },
    "openviking": {
      "enabled": false,
      "type": "http",
      "url": "http://127.0.0.1:1933/mcp",
      "headers": {
        "X-API-Key": "$OPENVIKING_API_KEY"
      },
      "description": "Official OpenViking tools for explicit memory and resource operations"
    },
    "douyin_openapi": {
      "enabled": false,
      "type": "stdio",
      "command": "douyin-openapi-mcp",
      "args": [],
      "env": {
        "DOUYIN_CLIENT_KEY": "$DOUYIN_CLIENT_KEY",
        "DOUYIN_CLIENT_SECRET": "$DOUYIN_CLIENT_SECRET",
        "DOUYIN_DEVICE_ID": "$DOUYIN_DEVICE_ID",
        "DOUYIN_APPROVED_SCOPES": "$DOUYIN_APPROVED_SCOPES"
      },
      "tool_name_prefix": false,
      "session_init_timeout": 30,
      "tool_call_timeout": 60,
      "description": "Manifest-driven official Douyin OpenAPI domains; enable only after adding douyin-openapi-mcp to DEER_FLOW_MCP_STDIO_COMMAND_ALLOWLIST",
      "routing": {
        "mode": "prefer",
        "priority": 80,
        "keywords": [
          "抖音",
          "Douyin",
          "粉丝画像",
          "素材库",
          "搜索视频",
          "生活服务"
        ]
      }
    },
    "douyin_official_mcp": {
      "enabled": false,
      "type": "stdio",
      "command": "douyin-official-mcp",
      "args": [],
      "env": {
        "DOUYIN_CLIENT_KEY": "$DOUYIN_CLIENT_KEY",
        "DOUYIN_CLIENT_SECRET": "$DOUYIN_CLIENT_SECRET",
        "DOUYIN_MCP_TOOL_GROUP_AIDS": "$DOUYIN_MCP_TOOL_GROUP_AIDS"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 30,
      "tool_call_timeout": 90,
      "description": "Token-refreshing bridge to the official Douyin MCP service marketplace; an empty tools/list means no MCP service is approved for the application yet",
      "routing": {
        "mode": "prefer",
        "priority": 90,
        "keywords": [
          "抖音",
          "Douyin",
          "视频搜索",
          "图文搜索",
          "经营任务"
        ]
      }
    },
    "postgres": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost/mydb"
      ],
      "env": {},
      "description": "PostgreSQL database access",
      "routing": {
        "mode": "prefer",
        "priority": 50,
        "keywords": [
          "database",
          "SQL",
          "table",
          "订单",
          "用户"
        ]
      },
      "tools": {
        "query": {
          "routing": {
            "mode": "prefer",
            "priority": 100,
            "keywords": [
              "查库",
              "订单表",
              "指标"
            ]
          }
        }
      }
    }
  },
  "skills": {}
}
